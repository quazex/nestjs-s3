{
  "name": "@quazex/nestjs-s3",
  "repository": {
    "type": "git",
    "url": "git://github.com/quazex/nestjs-s3.git"
  },
  "description": "NestJS module for AWS S3 client",
  "version": "1.2.0",
  "author": "Alexander Smirnov",
  "license": "MIT",
  "engines": {
    "node": ">= 24.x"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**"
  ],
  "keywords": [
    "s3",
    "nestjs",
    "nest",
    "typescript",
    "nodejs",
    "node"
  ],
  "scripts": {
    "build:clear": "rimraf lib",
    "build:compile": "npm run build:clear && tsc --project tsconfig.build.json",
    "dev:watch": "tsc --watch",
    "dev:check": "tsc --noEmit",
    "dev:lint": "eslint",
    "dev:format": "npm run dev:lint -- --fix",
    "dev:test": "vitest run",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.0.0",
    "@nestjs/common": ">=9.0.0 <12.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1014.0",
    "@faker-js/faker": "9.9.0",
    "@nestjs/common": "11.1.17",
    "@nestjs/testing": "11.1.17",
    "@quazex/eslint-config": "1.1.3",
    "@swc/core": "1.11.11",
    "@testcontainers/minio": "11.13.0",
    "husky": "9.1.7",
    "rimraf": "6.1.3",
    "testcontainers": "11.13.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.1",
    "vitest": "3.1.1"
  }
}
